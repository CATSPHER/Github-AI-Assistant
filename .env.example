# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any free-tier-friendly instruct model on HF Inference Providers.
# Good starting points: "meta-llama/Llama-3.1-8B-Instruct" or "Qwen/Qwen2.5-7B-Instruct"
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Free at https://console.groq.com/keys — no credit card needed
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# Served via HF Inference API (feature-extraction task) — uses HF_TOKEN above,
# no local download. Must be a model that supports the Inference API's
# feature-extraction task; sentence-transformers models generally do.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where the vector DB persists on disk
CHROMA_DIR=.chroma_store

# Classic PAT with 'repo' scope (read-only use), from https://github.com/settings/tokens
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
